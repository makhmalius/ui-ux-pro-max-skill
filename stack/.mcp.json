{
  "$schema": "https://json.schemastore.org/mcp.json",
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@0.0.83"]
    },
    "chrome-devtools": {
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@1.11.0"]
    },
    "shadcn": {
      "command": "npx",
      "args": ["-y", "shadcn@4.22.0", "mcp"]
    }
  }
}
